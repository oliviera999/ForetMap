# Dépendances
node_modules/

# Worktrees d'agents Claude Code (éphémères)
.claude/worktrees/

# Build frontend Vite
deploy/

# Dossiers de travail du build frontend récupéré depuis la branche d'artefacts
# (scripts/fetch-dist-artifact.js). Ils doivent rester hors du dépôt ET hors de
# `git status --porcelain`, que le cron de déploiement exige vide avant de pull.
dist.new/
dist.prev/
dist.candidate/
dist.discarded/

# Fichiers d'environnement (secrets)
.env
.env.local
.env.*.local

# Base de données SQLite (optionnel : décommenter si vous ne voulez pas versionner la DB)
# *.db
# *.sqlite
# *.sqlite3

# Secrets LTI locaux (clé privée outil — jamais versionner)
lti-keys/


# Médias GL locaux (import via npm run gl:import:media)
médias/
medias/

# Médias téléversés (runtime et tests) — ne jamais versionner.
#
# `uploads/` est alimenté par l'application (photos de zones et de repères, avatars, pièces
# jointes du forum, carnets) et par la suite de tests, qui y laisse ses fixtures. Rien n'y est
# du code : le dossier n'a jamais été suivi, et il ne doit pas l'être. Trois de ses familles
# sont d'ailleurs explicitement privées côté serveur — `observations/`, `task-logs/`,
# `user-journal/` (`lib/uploadsPrivatePaths.js`) — et deux autres portent des photos d'élèves
# (`students/`, `zones/`). Les versionner mettrait des données personnelles dans l'historique,
# c'est-à-dire exactement ce que `docs/AUDIT_SECURITE_2026-09-22.md` §12 relève comme blocage
# à la publication du dépôt.
uploads/

# Sauvegardes BDD (scripts/db-backup.sh) — ne jamais versionner (PII)
backups/
*.sql.gz
# Seule exception : le fixture ANONYMISÉ, produit par `npm run db:fixture:export`. Ce script
# refuse d'écrire tant que le balayage de `scripts/anonymize-local-db.js` trouve un e-mail ou
# un hachage bcrypt résiduel, et `tests/fixture-anonymise.test.js` revérifie l'archive
# versionnée à chaque CI. Un dump BRUT reste interdit, ici comme ailleurs.
!sql/fixtures/foretmap-anonymise.sql.gz

# Exports SQL complets — ne jamais versionner : ils portent des données personnelles
# (users, gl_players, password_reset_tokens, audit_log, forum_*). Pour alimenter
# `npm run db:import:biodiv`, extraire les seules tables de contenu via
# `node scripts/extract-biodiv-pedago-seed.js <dump.sql>` → sql/biodiv_pedago_seed.sql.
#
# Règle par LISTE BLANCHE (audit docs/AUDIT_BDD_2026-08.md §5.1) : les motifs ciblés
# ci-dessous laissaient passer le nom que phpMyAdmin et docs/LOCAL_DEV.md donnent
# réellement aux exports — `oliviera_foretmap.sql`, nommé d'après la base. Tout `.sql`
# est donc ignoré par défaut, et seuls les fichiers SQL du dépôt sont ré-autorisés.
*.sql
!sql/schema_foretmap.sql
!sql/biodiv_pedago_seed.sql
!sql/quiz_foretmap_data.sql
!sql/zones_lyautey_batiments.sql
!migrations/*.sql
sql/dumps/

# Logs
logs/
*.log
npm-debug.log*
ci-job-*-logs.zip
*.prod-dump.sql

# OS
.DS_Store
Thumbs.db

# IDE / outillage local
.idea/
.vscode/
.profillocal
tmp-*.txt
tmp/
*.bak

# Rapports Artillery horodatés (runs locaux ; les rapports déjà suivis le restent)
load/reports/*T*-*.json
*.swp
*.swo
*~
startup.log
startup-diag.log
playwright-report/
test-results/
blob-report/
