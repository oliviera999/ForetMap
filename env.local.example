# ForetMap — copier vers .env pour le dev local avec Docker (voir docs/LOCAL_DEV.md)
# Conteneur : MariaDB 11.4 (image mariadb:11.4.10). Ne pas utiliser ces identifiants en production (o2switch).

DB_HOST=127.0.0.1
DB_PORT=3306
# Si 3306 est déjà utilisé sur la machine : DB_PORT=3307 et, pour Docker Compose, la même ligne :
# FORETMAP_DB_PUBLISH_PORT=3307
DB_NAME=foretmap_local
DB_USER=root
DB_PASS=foretmap_local_root

PORT=3000
NODE_ENV=development

JWT_SECRET=dev_jwt_secret_local_only

# Optionnel : CORS proche prod (sinon CORS permissif en dev)
# FRONTEND_ORIGIN=http://localhost:3000

# Plafond du limiteur d'IP des routes d'authentification (tentatives / 15 min, défaut 60).
# La force brute est contrée par compte (lib/loginThrottle.js) ; ce plafond borne le volume global.
# FORETMAP_AUTH_RATE_LIMIT_PER_15MIN=60

# Lien Moodle (lot M1, pas encore lu par le code — voir docs/AUDIT_MOODLE_IDENTITES_2026-09.md).
# Le jeton Web Services reste dans ce fichier : jamais en base, jamais dans un réglage admin.
# MOODLE_BASE_URL=https://olution.info
# MOODLE_WS_TOKEN=
