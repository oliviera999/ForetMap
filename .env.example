# ForetMap — variables d'environnement (copier en .env, ne pas commiter .env)
# Production (o2switch) : définir ces variables dans l'interface "Setup Node.js App"

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=foretmap
DB_USER=foretmap_user
DB_PASS=votre_mot_de_passe
# Taille du pool mysql2 (défaut 30, max 100). Ajuster selon max_connections MySQL de l’hébergeur.
# FORETMAP_DB_CONNECTION_LIMIT=30

# Serveur
PORT=3000
NODE_ENV=production
# dotenv 17+ : journalisation à l'injection (désactiver si bruit en dev/scripts) — voir aussi database.js (quiet: true).
# DOTENV_CONFIG_QUIET=true
# Taille max des corps JSON/urlencoded hors médias/imports. Défaut 2mb (anti-LVE).
# Les imports bibliothèque GL volumineux utilisent multipart (Contenus → Bibliothèque).
# Préfixes photos/imports (visit, forum, plants, gl…) : FORETMAP_JSON_BODY_LIMIT_LARGE (défaut 25mb).
# FORETMAP_JSON_BODY_LIMIT=2mb
# FORETMAP_JSON_BODY_LIMIT_LARGE=25mb

# Import bibliothèque GL (multipart) — défauts : archive ZIP 50 Mo, fichier 32 Mo, décompressé 100 Mo, 200 fichiers.
# FORETMAP_CONTENT_LIBRARY_MAX_ARCHIVE_BYTES=50mb
# FORETMAP_CONTENT_LIBRARY_MAX_FILE_BYTES=32mb
# FORETMAP_CONTENT_LIBRARY_MAX_DECOMPRESSED_BYTES=100mb
# FORETMAP_CONTENT_LIBRARY_MAX_FILE_COUNT=200
# Import XLSX unitaire (panneaux espèces, glossaire, etc.) — défaut 8 Mo ; bibliothèque = MAX_FILE_BYTES ci-dessus.
# FORETMAP_GL_IMPORT_MAX_FILE_BYTES=8mb

# Export des données personnelles (RGPD) : plafond des fichiers joints à l'archive (octets, défaut 300 Mo).
# FORETMAP_EXPORT_MAX_FILES_BYTES=314572800
# Relais des images Wikimedia (GET /api/media/remote) : taille max d'une image en octets (défaut 8 Mo).
# FORETMAP_REMOTE_MEDIA_MAX_BYTES=8388608
# Plafond du cache disque de ce relais (uploads/remote-cache/, octets, défaut 500 Mo) : purge des
# plus anciens au-delà, au plus une fois par heure après un téléchargement.
# FORETMAP_REMOTE_MEDIA_CACHE_MAX_BYTES=524288000

# Marque affichée (lib/brand.js) — nom du logiciel et de l'établissement.
# Sans ces variables, l'installation reste « ForêtMap / Lycée Lyautey » : rien ne change.
# Lues DEUX fois avec les mêmes valeurs : au `npm run build` (titres de page, icônes
# d'installation, manifestes PWA) et au démarrage du serveur (défauts de réglages).
# Changer la marque impose donc de reconstruire le front, pas seulement de redémarrer.
# Un nom court omis suit son nom long. `ORG_NAME` vide est valide : installation sans
# établissement rattaché — la mention disparaît partout, sans séparateur orphelin.
# Guide non technique : docs/reference/exploitation/marque-et-domaines.md
# FORETMAP_BRAND_APP_NAME=ForêtMap
# FORETMAP_BRAND_APP_SHORT_NAME=ForêtMap
# FORETMAP_BRAND_ORG_NAME=Lycée Lyautey
# FORETMAP_BRAND_ORG_SHORT_NAME=Lyautey
# FORETMAP_BRAND_GL_NAME=Gnomes & Licornes
# FORETMAP_BRAND_GL_SHORT_NAME=G&L

# Derrière reverse proxy (nginx, Passenger) : nombre de hops (défaut 1 en production) ou « false » pour désactiver.
# FORETMAP_TRUST_PROXY=1

# Secret cookies visite anonyme (requis en production, min. 16 caractères).
# VISIT_COOKIE_SECRET=changez_moi_cookie_visite_long_aleatoire

# Limite express-rate-limit sur /api/* (requêtes / minute / IP). Défaut 1200 si absent — augmente si beaucoup d’élèves derrière la même IP (Wi‑Fi).
# FORETMAP_API_RATE_LIMIT_PER_MIN=1200

# Logs (Pino) : en dev sans variable = niveau debug ; en production = info.
# LOG_LEVEL=debug
# Socket.IO : erreurs Engine.IO « Session ID unknown » (reconnexion) en niveau debug côté serveur pour limiter le bruit en warn.
# (Debug) Si =1 : sur échec PUT /api/tasks/:id, les profs avec tasks.manage reçoivent debugDetail/debugCode dans le JSON 500.
# FORETMAP_DEBUG_TASK_PUT_CLIENT=

# HTTP : off | minimal (défaut prod : 5xx + requêtes lentes) | full (bruyant).
# FORETMAP_HTTP_LOG=minimal
# Seuil « lent » (ms) pour minimal (défaut 8000).
# FORETMAP_HTTP_SLOW_MS=8000
# Probabilité 0–1 de loguer un 429 rate limit (défaut 0.01), IP tronquée.
# FORETMAP_RATE_LIMIT_LOG_SAMPLE=0.01

# Auth / RBAC
# JWT_SECRET et VISIT_COOKIE_SECRET sont requis en production (min. 16 caractères chacun).
# La valeur ci-dessous est publique : le serveur refuse de démarrer en production avec elle
# (générer une valeur : `openssl rand -hex 32`).
JWT_SECRET=changez_moi_en_production_secret_long_aleatoire

# Double authentification (TOTP) des comptes administrateur et n3boss : clé de chiffrement
# AES-256-GCM des secrets en base, 32 octets (64 caractères hexadécimaux ou base64), DISTINCTE
# de JWT_SECRET. Générer : `openssl rand -hex 32` ; en garder une copie HORS du serveur (sans
# elle, aucun compte enrôlé ne peut plus valider son code). Absente : activation impossible.
# Voir docs/EXPLOITATION.md (§ Double authentification) et `node scripts/totp-admin.js status`.
# TOTP_ENCRYPTION_KEY=
# Rotation : ancienne(s) clé(s), séparées par des virgules, le temps de
# `node scripts/totp-admin.js rotate-key --yes`.
# TOTP_ENCRYPTION_KEY_PREVIOUS=

# Visite guidée (progression anonyme) : signature HMAC du cookie anon_visit_token.
# En production, définir une valeur dédiée (longue, aléatoire). Sinon repli sur JWT_SECRET puis secret de dev si NODE_ENV ≠ production.
# VISIT_COOKIE_SECRET=

# Compte prof email/mot de passe (optionnel, auto-seed au premier usage)
# TEACHER_ADMIN_EMAIL=prof@exemple.com
# TEACHER_ADMIN_PASSWORD=mot_de_passe_prof
# TEACHER_ADMIN_DISPLAY_NAME=Professeur

# CORS (production) : origine autorisée du frontend
# FRONTEND_ORIGIN=https://foretmap.olution.info
# Multi-origines (CSV), remplace FRONTEND_ORIGIN si défini (ex: ForetMap + G&L)
# FRONTEND_ORIGINS=https://foretmap.olution.info,https://gl.olution.info,https://planlyautey.olution.info
# Plan Lyautey (troisième produit, host planlyautey.*) : lecture seule, sans OAuth ni session.
# PLAN_PROD_BASE_URL=https://planlyautey.olution.info

# Sous-domaine Gnomes & Licornes (optionnel selon hébergement)
# GL_FRONTEND_ORIGIN=https://gl.olution.info
# Origines de retour OAuth autorisées (liste explicite, virgules) — recommandé sous un
# suffixe d'hébergement partagé (audit 2026-09-30 §6).
# FORETMAP_OAUTH_RETURN_ORIGINS=https://foretmap.example,https://gl.example
# GL_PASSWORD_RESET_BASE_URL=https://gl.olution.info

# OAuth Google dédié G&L (sinon fallback sur GOOGLE_OAUTH_CLIENT_ID/SECRET)
# GL_GOOGLE_OAUTH_CLIENT_ID=
# URI de redirection GL (sans www.) — à enregistrer tel quel dans Google Cloud Console :
# GL_GOOGLE_OAUTH_REDIRECT_URI=https://gl.olution.info/api/gl/auth/google/callback
# Si absent : dérivée de la requête (www. retiré, X-Forwarded-Proto). ForetMap et GL = 2 URI distinctes à autoriser.
# GL_GOOGLE_OAUTH_ALLOWED_DOMAINS=pedagolyautey.org,lyceelyautey.org
# GL_GOOGLE_OAUTH_ALLOWED_EMAILS=

# OAuth2 Google (optionnel) : connexion via comptes Google autorisés
# GOOGLE_OAUTH_CLIENT_ID=567947229654-c48g21orojrq20aofo6glheon95hummt.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=votre_secret_google
# GOOGLE_OAUTH_REDIRECT_URI=https://foretmap.olution.info/api/auth/google/callback
# Domaines autorisés (CSV) — défaut code : pedagolyautey.org,lyceelyautey.org
# GOOGLE_OAUTH_ALLOWED_DOMAINS=pedagolyautey.org,lyceelyautey.org
# Emails autorisés explicitement (CSV), pour les comptes HORS domaines ci-dessus.
# ⚠ Défaut code : liste VIDE (aucune adresse personnelle n'est écrite dans le dépôt).
# Un compte Google hors des domaines autorisés — typiquement l'admin sur une adresse
# personnelle — ne peut donc se connecter QUE si son adresse figure ici.
# GOOGLE_OAUTH_ALLOWED_EMAILS=prenom.nom@example.com

# Reset mot de passe (lien envoyé par email)
# PASSWORD_RESET_BASE_URL=https://foretmap.olution.info

# SMTP pour envoi d'emails (mot de passe oublié)
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=utilisateur_smtp
# SMTP_PASS=mot_de_passe_smtp
# SMTP_FROM="ForetMap <no-reply@exemple.com>"
# SMTP_JSON_TRANSPORT=true

# --- Exploitation : alertes & sauvegardes (scripts/ops-alert.js, db-backup.sh, uptime-check.sh) ---
# Destinataire des alertes d'exploitation (échec déploiement, rollback, sonde uptime).
# Défaut : SMTP_USER si non défini. Nécessite le SMTP ci-dessus configuré.
# OPS_ALERT_TO=admin@exemple.com
# Sauvegardes BDD : dossier de sortie (def ./backups) et rétention en jours (def 14).
# BACKUP_DIR=/home/USER/foretmap/backups
# BACKUP_RETENTION_DAYS=14
# Chiffrement des sauvegardes (AES-256, OpenSSL >= 1.1.1) : fichier de clé, chemin absolu, chmod 600.
# Génération : openssl rand -base64 48 > /home/USER/.foretmap-backup.key
# GARDER UNE COPIE DE LA CLÉ HORS DU SERVEUR : sans elle, aucune restauration possible.
# BACKUP_ENCRYPT_KEY_FILE=/home/USER/.foretmap-backup.key
# 1 = refuser toute sauvegarde en clair si la clé manque (défaut 0 : avertissement seulement).
# BACKUP_ENCRYPT_REQUIRED=1
# Restauration : bash scripts/db-restore.sh backups/foretmap-….sql.gz.enc [--check]
# Déploiement auto (scripts/auto-deploy-cron.sh) :
#   DEPLOY_AUTO_ROLLBACK=1          # rollback code si post-deploy-check échoue (def 1)
#   DEPLOY_DB_PRE_MIGRATE_BACKUP=1  # dump BDD avant db:migrate (def 1)

# --- Déploiement / admin distant (prod) ---
# Sur le serveur : uniquement DEPLOY_SECRET (obligatoire pour restart, logs, diagnostics).
# En local (.env non versionné), pour debug distant vous pouvez définir la même valeur sous 1 à 3 noms :
#   DEPLOY_SECRET              → canonique (aligné serveur) ; lu par deploy:check, prod:admin-tail, prod:remote-debug
#   FORETMAP_DEPLOY_CHECK_SECRET → alias pour les scripts npm ci-dessus
#   FORETMAP_DEPLOY_SECRET     → lu par Cursor MCP (foretmap-diagnostics) ; fallback DEPLOY_SECRET si défini dans l’env MCP
# Commandes utiles : npm run deploy:check:prod | prod:admin-diagnostics | prod:admin-tail | prod:remote-debug
# URL cible locale → distante : FORETMAP_PROD_BASE_URL=https://foretmap.olution.info
# URL cible G&L distante (optionnel pour scripts de vérification)
# GL_PROD_BASE_URL=https://gl.olution.info
# Captures d'installation PWA (`npm run pwa:screenshots`, vue « carte ») : compte de production
# utilisé pour photographier l'onglet Carte. Préférer un compte élève de démonstration.
# PWA_SCREENSHOT_IDENTIFIER=
# PWA_SCREENSHOT_PASSWORD=
# Redémarrage : POST /api/admin/restart avec header X-Deploy-Secret: <valeur>
# Logs tampon Pino : GET /api/admin/logs (même header) ; diag : GET /api/admin/diagnostics
# DEPLOY_SECRET=un_secret_long_aleatoire
# FORETMAP_DEPLOY_CHECK_SECRET=meme_valeur_que_deploy_secret
# FORETMAP_DEPLOY_SECRET=meme_valeur_que_deploy_secret

# Optionnel : taille du tampon de lignes pour GET /api/admin/logs (100–5000, défaut 2000)
# LOG_BUFFER_MAX_LINES=2000

# Optionnel : journal persistant du cycle de vie du process (démarrage / arrêt / crash).
# Alimente le champ `restarts` de GET /api/admin/diagnostics et `npm run prod:uptime-report`
# — c'est lui qui dit *pourquoi* le service a été indisponible (docs/EXPLOITATION.md).
# Activé par défaut hors NODE_ENV=test ; mettre 0 pour couper.
# FORETMAP_BOOT_JOURNAL=1
# FORETMAP_BOOT_JOURNAL_FILE=logs/boot-journal.ndjson
# FORETMAP_BOOT_JOURNAL_MAX_ENTRIES=800

# Optionnel (écoute)
# IP=0.0.0.0

# --- Pré-saisie biodiversité (extensions optionnelles, désactivées par défaut) ---
# Voir docs/SPECIES_AUTOFILL_EXTENSIONS.md — Wikipedia / GBIF / Wikidata : sources publiques, pas de clé ici.
# API Trefle (plantes) : sans les deux variables, aucun appel.
# TREFLE_TOKEN=
# SPECIES_AUTOFILL_TREFLE=1
# OpenAI (complément LLM serveur) : sans OPENAI_API_KEY et SPECIES_AUTOFILL_OPENAI=1, aucun appel.
# OPENAI_API_KEY=
# SPECIES_AUTOFILL_OPENAI=1
# SPECIES_AUTOFILL_OPENAI_MODEL=gpt-4o-mini
# Pl@ntNet (identification par image, POST /api/plants/plantnet-identify) : sans PLANTNET_API_KEY et SPECIES_AUTOFILL_PLANTNET=1, aucun appel.
# PLANTNET_API_KEY=
# SPECIES_AUTOFILL_PLANTNET=1
# PLANTNET_PROJECT=all
# PLANTNET_LANG=fr

# --- Connecteur MCP distant (/mcp + OAuth) — docs/MCP.md ---
# Clients : Claude, Cursor, ChatGPT, Gemini CLI (pas Gemini Enterprise / client secret).
# Désactivé par défaut : sans MCP_ENABLED=true, /mcp, /oauth/* et /.well-known/oauth-* répondent 404.
# MCP_ENABLED=false
# Origine publique EXACTE (pas de barre finale) : `resource` = <base>/mcp doit valoir l'URL saisie
# dans le client MCP. À poser en production.
# MCP_PUBLIC_BASE_URL=https://foretmap.example
# Côté Cursor (poste local) : FORETMAP_MCP_URL=https://foretmap.example/mcp  (voir .cursor/mcp.json)
# Contrôle d'activation : npm run mcp:activate-check -- --base https://foretmap.example
# Guide : docs/reference/foretmap/activer-le-connecteur.md
# Écriture de contenu (plan → apply) : ACTIVE par défaut, réservée aux comptes porteurs de
# `mcp.write` (profil admin) et à la portée foretmap.write. Mettre false pour la couper.
# MCP_WRITE_ENABLED=true
# --- Réglages du connecteur (docs/MCP.md § 13) : OUVERTS PAR DÉFAUT, pilotés depuis
# l'administration (Réglages → Exploitation → « Connecteur Claude »). Une variable POSÉE ci-dessous
# GAGNE TOUJOURS et VERROUILLE la clé correspondante (grisée dans l'interface). Mode « tout
# ouvert » : n'en poser AUCUNE. Mode « protégé » : décommenter les valeurs ci-dessous.
# MCP_WRITE_REQUIRE_PLAN=true          # ↔ mcp.write_mode (true = plan, false = direct)
# MCP_WRITE_SCOPE_POLICY=admin_only    # ↔ mcp.write_scope_policy (app_permissions | admin_only)
# MCP_API_BRIDGE_ENABLED=false         # ↔ mcp.api_bridge_enabled (foretmap_api, outils de domaine)
# MCP_API_BRIDGE_METHODS=GET           # ↔ mcp.api_bridge_methods
# MCP_API_BRIDGE_SENSITIVE_AUTH=false  # ↔ mcp.api_bridge_sensitive_auth
# MCP_DOMAINS_DISABLED=students,ops    # ↔ mcp.domains_disabled
# MCP_SQL_ENABLED=false                # ↔ mcp.sql_select_enabled
# MCP_SQL_SELECT_POOL=dedicated_only   # ↔ mcp.sql_select_pool (auto | dedicated_only)
# MCP_SQL_WRITE_ENABLED=false          # ↔ mcp.sql_write_enabled
# MCP_SQL_DDL_ENABLED=false            # ↔ mcp.sql_ddl_enabled
# MCP_SQL_MAX_AFFECTED_ROWS=100        # ↔ mcp.sql_max_affected_rows (1–1000000)
# MCP_CONFIRM_REQUIRED=true            # ↔ mcp.confirm_mode (true = sensitive, false = off)
# MCP_CONFIRM_MODE=all_writes          # ↔ mcp.confirm_mode (off | sensitive | all_writes)
# MCP_PRIVACY_BYPASS=false             # ↔ mcp.privacy_bypass (données nominatives d'élèves)
# MCP_PRIVACY_BYPASS_ACK=              # ↔ mcp.privacy_bypass_ack (AAAA-MM-JJ, informatif)
# MCP_PRIVACY_READS_AUDIT_DETAILS=full # ↔ mcp.privacy_reads_audit_details (summary | full)
# MCP_OPS_ENABLED=false                # ↔ mcp.ops_enabled (foretmap_ops)
# MCP_FILES_ENABLED=false              # ↔ mcp.files_enabled
# MCP_MAX_ROWS=500                     # ↔ mcp.max_rows (50–5000)
# MCP_MAX_OUTPUT_CHARS=120000          # ↔ mcp.max_output_chars
# MCP_TOOL_PROFILE=essentiel           # ↔ mcp.tool_profile (complet | essentiel)
# Durées (défauts : access 1 h, refresh 30 j, code 60 s, plan 60 min) et délai SQL par requête.
# MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_REFRESH_TOKEN_TTL_DAYS=30
# MCP_AUTH_CODE_TTL_SECONDS=60
# MCP_PLAN_TTL_MINUTES=60
# MCP_STATEMENT_TIMEOUT_MS=5000
# MCP_RATE_LIMIT_PER_MIN=300
# Redirections admises (défaut multi-clients ; `/*` = préfixe https). Port loopback ignoré.
# MCP_OAUTH_ALLOWED_REDIRECTS=https://claude.ai/api/mcp/auth_callback,http://localhost/callback,http://127.0.0.1/callback,https://www.cursor.com/agents/mcp/oauth/callback,http://localhost:8787/callback,https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/*,http://localhost/oauth/callback,http://127.0.0.1/oauth/callback
# MCP_CIMD_ENABLED=true
# MCP_DCR_ENABLED=true
# Compte MySQL en LECTURE SEULE (GRANT SELECT) pour les outils de lecture — recommandé quand
# l'hébergement le permet (node scripts/mcp-print-grants.js). Sans lui, foretmap_sql_select lit
# par le compte principal en transaction READ ONLY (réglage mcp.sql_select_pool=auto).
# DB_MCP_USER=
# DB_MCP_PASS=
# --- Connecteur MCP — exploitation (docs/MCP.md § 11) ---
# Racines consultables (nom=chemin, virgules) ; défaut : logs/, startup.log, stderr.log,
# .cpanel.yml, scripts/, docs/, migrations/.
# MCP_FILE_ROOTS=logs=logs,passenger=/home/USER/foretmap/stderr.log
# MCP_CRON_LOG_DIR=logs
# MCP_PASSENGER_LOG=
# MCP_CRON_READ_CRONTAB=false
# MCP_MEMORY_STALE_DAYS=90
# Jeton de GET /api/health/report (en-tête X-Health-Token) ; absent : route en 404.
# MCP_HEALTH_TOKEN=
# daily : e-mail du rapport chaque jour ; off : jamais ; défaut : seulement si orange ou rouge.
# MCP_HEALTH_REPORT_EMAIL=
# MCP_HEALTH_REPORT_RETENTION_DAYS=90
# HEALTH_REPORT_BASE_URL=https://foretmap.example
# MCP_HEALTH_TLS_HOSTS=foretmap.example,gl.foretmap.example
